# --- OS ---
.DS_Store

# --- Xcode / iOS app (the app lives at the repo root) ---
# Generated by XcodeGen — reproducible from project.yml, not committed.
AcuGuide.xcodeproj/
AcuGuide/Info.plist
# Xcode user/build state
xcuserdata/
DerivedData/
build/
*.xcuserstate
# Belt-and-braces: no xcconfig exists and the chat is fully on-device (no API key, no network),
# but keep the rule so a future secrets file can never be committed by accident.
Secrets.xcconfig

# --- Node / Vite build (archive/ web apps) ---
node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# --- Python analysis pipeline ---
.venv/
.venv-diag/
__pycache__/
*.pyc

# --- Analysis outputs (not part of the app) ---
outputs/
diagnostics/
diagnostics/overlays/

# --- Scratch: moved-aside scratch, raw data, and videos (do NOT commit) ---
# NOTE: this is _archive/ (underscore) — the tracked archive/ directory is NOT ignored.
_archive/

# --- Raw videos: never commit. (model.glb is intentionally NOT ignored — it's an app asset) ---
*.mov
*.MOV
*.mp4
*.webm
TrainingVid/
drive-download-*/

# --- Voice render pipeline (tools/voice) — build-time only, never committed ---
# The documented re-render downloads a ~350 MB Kokoro model and writes clips next to the script.
tools/voice/kokoro-*/
tools/voice/out_clips/
tools/voice/samples/
tools/voice/*.tar.bz2
